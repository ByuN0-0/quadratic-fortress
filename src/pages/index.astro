---
import QuadraticFortress from "../components/QuadraticFortress";
import "../styles/global.css";
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="꼭짓점 좌표로 포물선을 만들고 원의 방정식으로 피해를 계산하는 2인용 수학 게임"
    />
    <title>Quadratic Fortress</title>
  </head>
  <body>
    <script is:inline>
      window.addEventListener("error", (event) => {
        document.body.innerHTML = `<main class="game-shell mode-menu-screen"><section class="app-error-panel" role="alert"><p class="eyebrow">App Error</p><h1>화면을 불러오지 못했습니다</h1><p>${String(event.error?.message || event.message || "알 수 없는 오류")}</p></section></main>`;
      });
      window.addEventListener("unhandledrejection", (event) => {
        document.body.innerHTML = `<main class="game-shell mode-menu-screen"><section class="app-error-panel" role="alert"><p class="eyebrow">App Error</p><h1>화면을 불러오지 못했습니다</h1><p>${String(event.reason?.message || event.reason || "알 수 없는 오류")}</p></section></main>`;
      });
    </script>
    <QuadraticFortress client:only="react" />
  </body>
</html>
